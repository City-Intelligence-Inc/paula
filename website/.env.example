# Mathitude website — environment variables.
# Copy to .env.local and fill in. No real secrets live in this file or the repo.

# --- Clerk auth ---
# Leave both unset for KEYLESS dev mode (auto-provisions a temporary dev
# instance), or paste your Clerk instance keys.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- AWS / DynamoDB ---
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_PREFIX=mathitude-staging
# For local dev against dynalite (npm run db:local), point the SDK at it and
# disable request checksums (dynalite rejects them):
# AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
# AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
# AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED

# --- Admin access (no longer hardcoded in source) ---
# Comma-separated bootstrap master-admin emails. Required in each environment
# for anyone to have master-admin rights / the Admin nav link.
BOOTSTRAP_ADMIN_EMAILS=
# Comma-separated recipients for admin notification emails.
ADMIN_NOTIFICATION_EMAIL=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
